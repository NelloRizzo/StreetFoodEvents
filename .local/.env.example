# App locale — variabili per `docker compose` (copia in `.env`)
# Un solo comando per avviare tutto:  docker compose up --build

# Porta pubblica dell'app (API + UI statica)
PORT=4000

# Identificativo macchina (compare nel log e nel /health)
MACHINE_ID=prototipo-demo

# Sync remoto: base URL del backend cloud e token condiviso (deve combaciare
# con SYNC_API_TOKEN configurato sul cloud)
REMOTE_URL=https://streetfoodevents-api.onrender.com/api
REMOTE_TOKEN=

# Seed automatico al primo avvio (1 = esegui, 0 = salta)
SEED=1

# Prefisso URL dell'endpoint statico per le immagini locali scaricate
ASSETS_URL_PREFIX=/assets
