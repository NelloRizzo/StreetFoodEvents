NODE_ENV=development
PORT=4000
AUTH_SESSION_COOKIE_NAME=sid
AUTH_SESSION_TTL_HOURS=12

CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/street_food_events

CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Brevo (ex Sendinblue) per invio foto via email
BREVO_API_KEY=replace-with-brevo-api-key
EMAIL_FROM=noreply@your-verified-domain.com

# Sync remoto (app locale offline) — token condiviso per le chiamate server-to-server
# Il backend cloud genera/serve lo snapshot, l'app locale (`.local/`) legge questo token
SYNC_API_TOKEN=replace-with-a-long-random-string
